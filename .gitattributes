# Normalize line endings so a Windows checkout cannot break shell scripts,
# workflow files or the byte-exact SHA-256 sums that pin the vendored design
# files (design/SHA256SUMS) and the built docs.
* text=auto eol=lf
*.sh text eol=lf
*.mjs text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.woff2 binary
